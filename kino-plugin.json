{
  "id": "cf-test",
  "name": "CF Test",
  "version": "0.1.0",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Prueba del bypass de Cloudflare: abre una URL en el navegador oculto (browser.page) y la resuelve por la door del resolver. Solo para pruebas.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-cf-test",
  "hosts": [],
  "fetchHosts": "any",
  "browser": "pages",
  "capabilities": ["screen"],
  "screen": {
    "label": "CF Test",
    "labelEn": "CF Test",
    "icon": "bug_report",
    "menuOpens": "screen",
    "opensFrom": ["menu"]
  },
  "recommends": ["xuper-plugin/kino-plugin-kino-resolver"],
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": ["resolve"]
    }
  }
}
